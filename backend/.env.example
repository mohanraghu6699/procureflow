DATABASE_URL=postgresql+psycopg2://procureflow_app:CHANGE_ME@localhost:5432/procureflow
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API; set to the deployed frontend URL in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Read only by `python -m app.seed`, and only when it creates the users (empty database).
# One password per role, at least 8 characters. Leave a line commented out to get a random password printed once.
# SEED_ADMIN_PASSWORD=
# SEED_REQUESTER_PASSWORD=
# SEED_APPROVER_PASSWORD=
