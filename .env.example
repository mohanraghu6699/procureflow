# Read by `docker compose` (docker-compose.yml). Copy this file to ".env" in the same folder and edit it;
# ".env" is git-ignored. A variable already set in your shell wins over the file.
# The example values below are placeholders: replace the passwords and the JWT key with your own.

# ---- Database (the postgres container, and the backend's connection to it) -----------------------
POSTGRES_USER=procureflow_app
# URL-safe characters only (letters, digits, - _ .): it is embedded in the backend's connection URL.
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=procureflow

# ---- Backend -------------------------------------------------------------------------------------
# Signing key for login tokens: a long random string (32+ characters).
JWT_SECRET_KEY=change-me-to-a-long-random-string-32-chars-or-more
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
# Addresses a browser may call the API from: the frontend's own address, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login passwords for the seeded accounts, one per role, at least 8 characters. Used only when the database is
# first created. Leave blank to get random ones, printed once by: docker compose logs backend
SEED_ADMIN_PASSWORD=
SEED_REQUESTER_PASSWORD=
SEED_APPROVER_PASSWORD=

# ---- Frontend ------------------------------------------------------------------------------------
# The address a browser uses to reach the backend. Baked into the JavaScript when the image is built.
VITE_API_BASE_URL=http://localhost:8000

# ---- Ports published on your machine -------------------------------------------------------------
# Keep these consistent with CORS_ORIGINS (frontend port) and VITE_API_BASE_URL (backend port).
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
