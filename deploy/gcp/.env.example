# Settings for deploy/gcp/*.sh. Copy this file to ".env" in this folder (git-ignored) and edit it.
#
# Precedence: a variable already set in your shell  >  this file  >  the scripts' built-in defaults.
# One KEY=VALUE per line. Quotes are optional. Do not add a comment after a value. Empty = use the default,
# where one exists (the required settings named below have none).

# ---- Where and what to create -------------------------------------------------------------------
# Defaults to the project set in `gcloud config`.
PROJECT_ID=
REGION=us-central1
# Prefix for every resource name (services, database, secrets, service accounts).
APP=procureflow
# Blank = "<APP>-db". Google reserves a deleted instance's name for a while, so use a new one after destroy.
SQL_INSTANCE=
SQL_TIER=db-f1-micro
DB_NAME=procureflow
# Cloud SQL's built-in admin, the only value accepted: it owns the schema the migrations create.
DB_USER=postgres
# 0 = scale to zero when idle (first request after a quiet period waits ~10-15s). 1 = keep one instance warm (~$10/month).
API_MIN_INSTANCES=0

# ---- Settings passed to the API (Cloud Run environment variables) -------------------------------
# The API has no built-in defaults, so LOG_LEVEL, ACCESS_TOKEN_EXPIRE_MINUTES and JWT_ALGORITHM are REQUIRED:
# deploy.sh and update.sh stop and name any that are missing.
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256
# Optional: extra browser origins allowed to call the API, comma-separated (e.g. a custom domain). The API's
# CORS_ORIGINS itself is computed by the scripts from the web app's Cloud Run addresses.
CORS_EXTRA_ORIGINS=

# ---- Secrets (stored in Secret Manager, never in the service configuration) ----------------------
# Database password for DB_USER: at least 16 characters, only letters, digits and . _ ~ - (it is embedded in the
# connection URL). Blank = generate a random one on the first deploy and keep it. Changing it later takes effect
# on the next deploy.sh, which applies it just before releasing the API.
DB_PASSWORD=
# JWT signing key, at least 32 characters. Blank = generate a random one on the first deploy and keep it.
# Changing it later signs everyone out.
JWT_SECRET_KEY=
# Login passwords for the seeded accounts, one per role, at least 8 characters. They are only used when the
# API seeds an EMPTY database (the first deploy). To apply changed values to existing accounts later, run
# `bash deploy/gcp/update.sh --sync-passwords`. A role left blank gets a random password on the first deploy,
# which deploy.sh prints once (it is also in the API's log), and is left alone by --sync-passwords.
SEED_ADMIN_PASSWORD=
SEED_REQUESTER_PASSWORD=
SEED_APPROVER_PASSWORD=
